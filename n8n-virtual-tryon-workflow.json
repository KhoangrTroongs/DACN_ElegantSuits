{
    "name": "Virtual Try-On Workflow",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "virtual-try-on",
                "responseMode": "responseNode",
                "options": {}
            },
            "id": "webhook-node",
            "name": "Webhook",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                250,
                300
            ],
            "webhookId": "virtual-try-on"
        },
        {
            "parameters": {
                "jsCode": "// Extract data from webhook\nconst productName = $input.item.json.body.productName;\nconst productImageUrl = $input.item.json.body.productImageUrl;\nconst customerImageBase64 = $input.item.json.body.customerImage;\n\n// Remove data:image prefix if exists\nlet customerImageData = customerImageBase64;\nif (customerImageData.includes('base64,')) {\n  customerImageData = customerImageData.split('base64,')[1];\n}\n\n// Convert base64 to buffer\nconst customerImageBuffer = Buffer.from(customerImageData, 'base64');\n\nreturn {\n  productName,\n  productImageUrl,\n  customerImageBuffer,\n  customerImageBase64\n};"
            },
            "id": "process-input",
            "name": "Process Input",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                450,
                300
            ]
        },
        {
            "parameters": {
                "url": "={{ $json.productImageUrl }}",
                "options": {
                    "response": {
                        "response": {
                            "responseFormat": "file"
                        }
                    }
                }
            },
            "id": "download-product-image",
            "name": "Download Product Image",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                650,
                200
            ]
        },
        {
            "parameters": {
                "operation": "text",
                "modelId": {
                    "__rl": true,
                    "value": "gemini-1.5-flash",
                    "mode": "list",
                    "cachedResultName": "Gemini 1.5 Flash"
                },
                "prompt": "=You are an AI fashion assistant. Generate a realistic image of a person wearing the product.\n\nProduct: {{ $('Process Input').item.json.productName }}\n\nInstructions:\n1. Take the person's image and the product image\n2. Realistically overlay the product onto the person\n3. Maintain natural lighting and proportions\n4. Ensure the product fits naturally on the person's body\n5. Keep the background from the person's original image\n\nGenerate a high-quality, realistic result.",
                "options": {
                    "temperature": 0.7,
                    "maxOutputTokens": 2048
                },
                "text": "",
                "imageDataPropertyName": "data"
            },
            "id": "gemini-ai",
            "name": "Gemini AI - Generate Try-On",
            "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
            "typeVersion": 1,
            "position": [
                850,
                300
            ],
            "credentials": {
                "googleGeminiOAuth2Api": {
                    "id": "YOUR_GEMINI_CREDENTIAL_ID",
                    "name": "Google Gemini account"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "// Get the generated image from Gemini\nconst geminiResponse = $input.item.json;\n\n// Convert image to base64 if needed\nlet resultImageBase64;\n\nif (geminiResponse.data) {\n  // If Gemini returns binary data\n  resultImageBase64 = 'data:image/png;base64,' + Buffer.from(geminiResponse.data).toString('base64');\n} else if (geminiResponse.image) {\n  // If Gemini returns base64\n  resultImageBase64 = geminiResponse.image;\n} else {\n  // Fallback: use a placeholder or error image\n  resultImageBase64 = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==';\n}\n\nreturn {\n  success: true,\n  resultImage: resultImageBase64,\n  message: 'Virtual try-on generated successfully'\n};"
            },
            "id": "format-response",
            "name": "Format Response",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1050,
                300
            ]
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={{ $json }}",
                "options": {
                    "responseHeaders": {
                        "entries": [
                            {
                                "name": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "name": "Access-Control-Allow-Origin",
                                "value": "*"
                            }
                        ]
                    }
                }
            },
            "id": "respond-to-webhook",
            "name": "Respond to Webhook",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1,
            "position": [
                1250,
                300
            ]
        },
        {
            "parameters": {
                "jsCode": "// Error handling\nreturn {\n  success: false,\n  resultImage: null,\n  message: 'Failed to generate virtual try-on image',\n  error: $input.item.json.error || 'Unknown error'\n};"
            },
            "id": "error-handler",
            "name": "Error Handler",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1050,
                500
            ]
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={{ $json }}",
                "options": {
                    "responseCode": 500,
                    "responseHeaders": {
                        "entries": [
                            {
                                "name": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "name": "Access-Control-Allow-Origin",
                                "value": "*"
                            }
                        ]
                    }
                }
            },
            "id": "respond-error",
            "name": "Respond Error",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1,
            "position": [
                1250,
                500
            ]
        }
    ],

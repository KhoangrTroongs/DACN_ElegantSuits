                                                    @if (!string.IsNullOrEmpty(item.Model3DUrl))
                                                    {
                                                        <span class="badge bg-info ms-1" title="C� m� h�nh 3D">
                                                            <i class="fas fa-cube"></i>
                                                        </span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge bg-elegant-secondary">@item.Category.Name</span>
                                                </td>
                                                <td class="product-price">@item.Price.ToString("N0") VN�</td>
                                                <td>
                                                    <span class="badge bg-@(item.Quantity > 0 ? "success" : "danger") product-stock">
                                                        @(item.Quantity > 0 ? item.Quantity.ToString() : "H?t h�ng")
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (item.IsHidden)
                                                    {
                                                        <span class="badge bg-warning text-dark">
                                                            <i class="fas fa-eye-slash me-1"></i>�� ?n
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-info">
                                                            <i class="fas fa-eye me-1"></i>Hi?n th?
                                                        </span>
                                                    }
                                                </td>

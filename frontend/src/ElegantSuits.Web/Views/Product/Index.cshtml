                                            "price-asc" => "Gi�: Th?p d?n Cao",
                                            "price-desc" => "Gi�: Cao d?n Th?p",
                                            "name-asc" => "T�n: A d?n Z",
                                            "name-desc" => "T�n: Z d?n A",

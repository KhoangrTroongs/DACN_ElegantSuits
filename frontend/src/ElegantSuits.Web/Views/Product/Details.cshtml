    <script>
        $(document).ready(function () {
            // X? l� form th�m v�o gi? h�ng
            $('.add-to-cart-form').on('submit', function (e) {
                e.preventDefault();
                var form = $(this);

                // Ki?m tra xem ngu?i d�ng d� dang nh?p chua
                var isAuthenticated = @(User.Identity.IsAuthenticated ? "true" : "false");
                if (!isAuthenticated) {
                    // Chuy?n hu?ng d?n trang dang nh?p
                    window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                    return;
                }

                // Ki?m tra xem d� ch?n size chua (n?u c� size)
                if ($('.size-box').length > 0 && !$('.size-box.selected').length) {
                    alert('Vui l�ng ch?n k�ch c? tru?c khi th�m v�o gi? h�ng.');
                    return;
                }

                // Th�m size v�o form n?u d� ch?n
                if ($('.size-box.selected').length) {
                    var selectedSize = $('.size-box.selected').data('size');
                    form.append('<input type="hidden" name="size" value="' + selectedSize + '">');
                }

                $.ajax({
                    url: form.attr('action'),
                    method: 'POST',
                    data: form.serialize(),
                    success: function (response) {
                        if (response.success) {
                            // Update cart badge
                            $('.badge.bg-danger').text(response.cartCount);
                            // Optional: Show success message
                            alert('�� th�m s?n ph?m v�o gi? h�ng!');
                        } else if (response.message) {
                            alert(response.message);
                        }
                    },
                    error: function (xhr) {
                        if (xhr.status === 401) {
                            // Ngu?i d�ng chua dang nh?p
                            window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                        } else {
                            alert('C� l?i x?y ra khi th�m v�o gi? h�ng.');
                        }
                    }
                });
            });

            // X? l� ch?n size
            $('.size-box').on('click', function() {
                if ($(this).hasClass('disabled')) {
                    return;
                }

                $('.size-box').removeClass('selected');
                $(this).addClass('selected');
            });

            // X? l� hi?n th? form d�nh gi�
            $('#write-review-btn, #be-first-review-btn').on('click', function() {
                $('#review-form').slideDown();
            });

            // X? l� ?n form d�nh gi�
            $('#cancel-review-btn').on('click', function() {
                $('#review-form').slideUp();
            });

            // X? l� d�nh gi� sao khi nh?p
            $('.form-check-input[name="Rating"]').on('change', function() {
                var rating = $(this).val();

                // C?p nh?t hi?n th? m� t? d�nh gi�
                $('.rating-text').text(rating + ' sao: ' + getRatingText(rating));

                console.log('�� ch?n ' + rating + ' sao');
            });

            // H�m l?y m� t? cho s? sao
            function getRatingText(rating) {
                switch(parseInt(rating)) {
                    case 1: return 'R?t t?';
                    case 2: return 'T?';
                    case 3: return 'B�nh thu?ng';
                    case 4: return 'T?t';
                    case 5: return 'R?t t?t';
                    default: return 'Ch?n s? sao d? d�nh gi�';
                }
            }

            // X? l� ki?m tra form tru?c khi g?i
            $('#review-form-submit').on('submit', function(event) {
                var form = $(this);
                var selectedRating = $('input[name="Rating"]:checked').val();

                // Ki?m tra xem d� ch?n s? sao chua
                if (!selectedRating) {
                    event.preventDefault();
                    event.stopPropagation();
                    $('.rating-text').addClass('text-danger').text('Vui l�ng ch?n s? sao d�nh gi�');
                    return false;
                }

                // Hi?n th? th�ng b�o dang g?i
                if (form[0].checkValidity() !== false) {
                    $('.rating-text').removeClass('text-danger');

                    // Log th�ng tin d�nh gi� d? ki?m tra
                    console.log('G?i d�nh gi�:');
                    console.log('- S? sao: ' + selectedRating);
                    console.log('- B�nh lu?n: ' + $('#comment').val());
                }

                form.addClass('was-validated');
            });
        });
    </script>
}

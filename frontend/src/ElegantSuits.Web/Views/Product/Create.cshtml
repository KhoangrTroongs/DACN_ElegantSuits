<!-- Modal ch?nh s?a k�ch c? -->
<div class="modal fade" id="editSizeModal" tabindex="-1" aria-labelledby="editSizeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editSizeModalLabel">Ch?nh s?a k�ch c?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="editSizeInput" class="form-label">K�ch c?</label>
                    <input type="text" class="form-control" id="editSizeInput" required readonly />
                </div>
                <div class="mb-3">
                    <label for="editQuantityInput" class="form-label">S? lu?ng</label>
                    <input type="number" class="form-control" id="editQuantityInput" required min="0" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">H?y</button>
                <button type="button" class="btn btn-primary" id="saveEditBtn">Luu thay d?i</button>
            </div>
        </div>
    </div>
</div>

<!-- Th�m input ?n d? luu th�ng tin k�ch c? -->
<input type="hidden" id="productSizes" name="ProductSizes" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
            // Kh?i t?o m?ng luu tr? k�ch c?
            var sizes = [];

            // Hi?n th?/?n th�ng b�o kh�ng c� k�ch c?
            function updateNoSizesMessage() {
                if (sizes.length === 0) {
                    $('#noSizesMessage').show();
                    $('#sizesTable').hide();
                } else {
                    $('#noSizesMessage').hide();
                    $('#sizesTable').show();
                }
            }

            // C?p nh?t b?ng k�ch c?
            function updateSizesTable() {
                var tbody = $('#sizesTable tbody');
                tbody.empty();

                sizes.forEach(function(item) {
                    var row = $('<tr>');
                    row.append($('<td>').text(item.size));
                    row.append($('<td>').text(item.quantity));

                    var actionsCell = $('<td>');

                    // N�t x�a
                    var deleteBtn = $('<button>')
                        .addClass('btn btn-danger btn-sm me-1')
                        .attr('type', 'button')
                        .attr('data-size', item.size)
                        .html('<i class="fas fa-trash"></i>')
                        .click(function() {
                            if (confirm('B?n c� ch?c ch?n mu?n x�a k�ch c? n�y?')) {
                                var sizeToDelete = $(this).data('size');
                                sizes = sizes.filter(function(s) {
                                    return s.size !== sizeToDelete;
                                });
                                updateSizesTable();
                                updateTotalQuantity();
                                updateNoSizesMessage();
                            }
                        });

                    // N�t s?a
                    var editBtn = $('<button>')
                        .addClass('btn btn-primary btn-sm')
                        .attr('type', 'button')
                        .attr('data-size', item.size)
                        .attr('data-quantity', item.quantity)
                        .html('<i class="fas fa-edit"></i>')
                        .click(function() {
                            var size = $(this).data('size');
                            var quantity = $(this).data('quantity');

                            $('#editSizeInput').val(size);
                            $('#editQuantityInput').val(quantity);

                            $('#editSizeModal').modal('show');
                        });

                    actionsCell.append(deleteBtn);
                    actionsCell.append(editBtn);
                    row.append(actionsCell);

                    tbody.append(row);
                });

                // C?p nh?t input ?n
                updateSizesInput();
            }

            // C?p nh?t t?ng s? lu?ng
            function updateTotalQuantity() {
                var total = 0;
                sizes.forEach(function(item) {
                    total += parseInt(item.quantity);
                });
                $('#Quantity').val(total);
            }

            // C?p nh?t input ?n
            function updateSizesInput() {
                $('#productSizes').val(JSON.stringify(sizes));
            }

            // Kh?i t?o
            updateNoSizesMessage();

            // X? l� s? ki?n khi nh?n n�t th�m k�ch c?
            $('#addSizeBtn').click(function() {
                var size = $('#sizeInput').val().trim();
                var quantity = parseInt($('#quantityInput').val());

                if (!size) {
                    alert('Vui l�ng nh?p k�ch c?');
                    return;
                }

                if (isNaN(quantity) || quantity < 0) {
                    alert('S? lu?ng ph?i l� s? kh�ng �m');
                    return;
                }

                // Ki?m tra xem k�ch c? d� t?n t?i chua
                var existingSize = sizes.find(function(item) {
                    return item.size === size;
                });

                if (existingSize) {
                    alert('K�ch c? n�y d� t?n t?i. Vui l�ng s? d?ng ch?c nang ch?nh s?a.');
                    return;
                }

                // Th�m k�ch c? m?i
                sizes.push({
                    size: size,
                    quantity: quantity
                });

                // C?p nh?t giao di?n
                updateSizesTable();
                updateTotalQuantity();
                updateNoSizesMessage();

                // X�a d? li?u nh?p
                $('#sizeInput').val('');
                $('#quantityInput').val(0);
            });

            // X? l� s? ki?n khi nh?n n�t luu ch?nh s?a
            $('#saveEditBtn').click(function() {
                var size = $('#editSizeInput').val();
                var quantity = parseInt($('#editQuantityInput').val());

                if (isNaN(quantity) || quantity < 0) {
                    alert('S? lu?ng ph?i l� s? kh�ng �m');
                    return;
                }

                // C?p nh?t k�ch c?
                var sizeIndex = sizes.findIndex(function(item) {
                    return item.size === size;
                });

                if (sizeIndex !== -1) {
                    sizes[sizeIndex].quantity = quantity;

                    // C?p nh?t giao di?n
                    updateSizesTable();
                    updateTotalQuantity();

                    // ��ng modal
                    $('#editSizeModal').modal('hide');
                }
            });

            // X? l� s? ki?n khi nh?n n�t luu thay d?i
            $('#saveSizesBtn').click(function() {
                // ��ng modal
                $('#sizesModal').modal('hide');
            });

            // X? l� s? ki?n khi submit form
            $('form').submit(function() {
                // Th�m th�ng tin k�ch c? v�o m� t? s?n ph?m
                if (sizes.length > 0) {
                    var sizeSection = sizes.map(function(item) {
                        return item.size + ':' + item.quantity;
                    }).join(',');

                    var description = $('#Description').val() || '';

                    // Th�m ph?n k�ch c? v�o cu?i m� t?
                    if (description) {
                        description += '\n\n';
                    }
                    description += '[SIZES]' + sizeSection + '[/SIZES]';

                    $('#Description').val(description);
                }

                return true;
            });
        });
    </script>
}
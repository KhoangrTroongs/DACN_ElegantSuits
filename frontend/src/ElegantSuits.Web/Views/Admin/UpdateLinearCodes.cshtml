@{
    ViewData["Title"] = "Cập nhật mã Linear";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4><i class="fas fa-barcode"></i> Cập nhật mã Linear cho sản phẩm</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        <strong>Thông tin:</strong> Chức năng này sẽ cập nhật mã Linear (Barcode) cho tất cả 150 sản phẩm từ file Excel.
                    </div>

                    <div id="result" class="mt-3"></div>

                    <button id="btnUpdate" class="btn btn-primary btn-lg btn-block">
                        <i class="fas fa-sync-alt"></i> Cập nhật mã Linear
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#btnUpdate').click(function() {
                var btn = $(this);
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang cập nhật...');
                
                $.ajax({
                    url: '/api/LinearCode/update-all',
                    type: 'POST',
                    headers: {
                        'Authorization': 'Bearer ' + localStorage.getItem('token')
                    },
                    success: function(response) {
                        $('#result').html(
                            '<div class="alert alert-success">' +
                            '<i class="fas fa-check-circle"></i> ' +
                            '<strong>Thành công!</strong> ' + response.message +
                            '</div>'
                        );
                        btn.prop('disabled', false).html('<i class="fas fa-sync-alt"></i> Cập nhật mã Linear');
                    },
                    error: function(xhr) {
                        $('#result').html(
                            '<div class="alert alert-danger">' +
                            '<i class="fas fa-exclamation-circle"></i> ' +
                            '<strong>Lỗi!</strong> ' + (xhr.responseJSON?.message || 'Không thể cập nhật') +
                            '</div>'
                        );
                        btn.prop('disabled', false).html('<i class="fas fa-sync-alt"></i> Cập nhật mã Linear');
                    }
                });
            });
        });
    </script>
}

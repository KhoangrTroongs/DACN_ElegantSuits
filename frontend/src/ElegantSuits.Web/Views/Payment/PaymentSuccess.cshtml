@{
    ViewData["Title"] = "Thanh toán thành công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-success text-white text-center py-4">
                    <i class="fas fa-check-circle fa-4x mb-3"></i>
                    <h2 class="mb-0">Thanh toán thành công!</h2>
                </div>
                <div class="card-body p-5">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">
                            <i class="fas fa-info-circle me-2"></i>
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    <div class="text-center mb-4">
                        <p class="lead">Cảm ơn bạn đã đặt hàng! Đơn hàng của bạn đã được xác nhận và đang được xử lý.</p>
                    </div>

                    <div class="row mt-4">
                        <div class="col-md-6 mb-3">
                            <a href="@Url.Action("MyOrders", "ShoppingCart")" class="btn btn-primary btn-lg w-100">
                                <i class="fas fa-list me-2"></i>Xem đơn hàng của tôi
                            </a>
                        </div>
                        <div class="col-md-6 mb-3">
                            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary btn-lg w-100">
                                <i class="fas fa-home me-2"></i>Về trang chủ
                            </a>
                        </div>
                    </div>

                    <div class="mt-5 p-4 bg-light rounded">
                        <h5 class="mb-3"><i class="fas fa-info-circle me-2"></i>Thông tin quan trọng</h5>
                        <ul class="list-unstyled">
                            <li class="mb-2">
                                <i class="fas fa-envelope text-primary me-2"></i>
                                Chúng tôi đã gửi email xác nhận đến địa chỉ email của bạn
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-truck text-primary me-2"></i>
                                Đơn hàng sẽ được giao trong vòng 3-5 ngày làm việc
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-phone text-primary me-2"></i>
                                Nếu có thắc mắc, vui lòng liên hệ: 1900-xxxx
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 15px;
        overflow: hidden;
    }

    .card-header {
        border-bottom: none;
    }

    .btn-lg {
        padding: 12px 24px;
        font-size: 1.1rem;
    }

    .fa-check-circle {
        animation: scaleIn 0.5s ease-in-out;
    }

    @@keyframes scaleIn {
        from {
            transform: scale(0);
            opacity: 0;
        }
        to {
            transform: scale(1);
            opacity: 1;
        }
    }
</style>

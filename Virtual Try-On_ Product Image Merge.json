    {
      "parameters": {
        "jsCode": "const productName = items[0].json.productName;\nconst sheetData = items[1].json;\n\nconst product = sheetData.find(\n  row => row['Product Name'] && row['Product Name'].toLowerCase() === productName.toLowerCase()\n);\n\nif (!product) {\n  throw new Error(`Product not found: ${productName}`);\n}\n\nreturn [{\n  json: {\n    productName: product['Product Name'],\n    productImageUrl: product['Product Image URL'],\n    productId: product['Product ID'],\n    customerImage: items[0].json.customerImage,\n    email: items[0].json.email,\n    callbackUrl: items[0].json.callbackUrl\n  }\n}];"
      },

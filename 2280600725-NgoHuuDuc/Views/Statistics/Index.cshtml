@model NgoHuuDuc_2280600725.Models.ViewModels.StatisticsViewModel
@using NgoHuuDuc_2280600725.Models.Enums
@using NgoHuuDuc_2280600725.Extensions

@{
    ViewData["Title"] = "Thống kê";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-chart-line me-2" style="color: var(--elegant-gold);"></i>
            Thống kê
        </h1>
    </div>

    <!-- Bộ lọc thời gian -->
    <div class="card card-elegant mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label for="startDate" class="form-label">Từ ngày</label>
                    <input type="date" id="startDate" name="startDate" class="form-control" value="@ViewBag.StartDate" />
                </div>
                <div class="col-md-4">
                    <label for="endDate" class="form-label">Đến ngày</label>
                    <input type="date" id="endDate" name="endDate" class="form-control" value="@ViewBag.EndDate" />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-filter me-1"></i> Lọc
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Thống kê tổng quan -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="dashboard-stat">
                <div class="dashboard-stat-icon">
                    <i class="fas fa-shopping-cart"></i>
                </div>
                <div class="dashboard-stat-value">@Model.TotalOrders</div>
                <div class="dashboard-stat-label">Tổng đơn hàng</div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="dashboard-stat">
                <div class="dashboard-stat-icon">
                    <i class="fas fa-dollar-sign"></i>
                </div>
                <div class="dashboard-stat-value">@Model.TotalRevenue.ToString("N0")₫</div>
                <div class="dashboard-stat-label">Doanh thu (Đã giao hàng)</div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="dashboard-stat">
                <div class="dashboard-stat-icon">
                    <i class="fas fa-box"></i>
                </div>
                <div class="dashboard-stat-value">@Model.TotalProducts</div>
                <div class="dashboard-stat-label">Tổng sản phẩm</div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="dashboard-stat">
                <div class="dashboard-stat-icon">
                    <i class="fas fa-users"></i>
                </div>
                <div class="dashboard-stat-value">@Model.TotalUsers</div>
                <div class="dashboard-stat-label">Tổng người dùng</div>
            </div>
        </div>
    </div>

    <!-- Thống kê đơn hàng theo trạng thái -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="dashboard-stat" style="border-left: 4px solid #ffc107;">
                <div class="dashboard-stat-icon" style="background: linear-gradient(135deg, #ffc107 0%, #e0a800 100%);">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="dashboard-stat-value" style="color: #ffc107;">@Model.PendingOrders</div>
                <div class="dashboard-stat-label">Đơn chờ xử lý</div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="dashboard-stat" style="border-left: 4px solid #17a2b8;">
                <div class="dashboard-stat-icon" style="background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);">
                    <i class="fas fa-check"></i>
                </div>
                <div class="dashboard-stat-value" style="color: #17a2b8;">@Model.ConfirmedOrders</div>
                <div class="dashboard-stat-label">Đã xác nhận</div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="dashboard-stat" style="border-left: 4px solid #6f42c1;">
                <div class="dashboard-stat-icon" style="background: linear-gradient(135deg, #6f42c1 0%, #5a32a3 100%);">
                    <i class="fas fa-truck"></i>
                </div>
                <div class="dashboard-stat-value" style="color: #6f42c1;">@Model.ShippingOrders</div>
                <div class="dashboard-stat-label">Đang giao hàng</div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="dashboard-stat" style="border-left: 4px solid #28a745;">
                <div class="dashboard-stat-icon" style="background: linear-gradient(135deg, #28a745 0%, #1e7e34 100%);">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="dashboard-stat-value" style="color: #28a745;">@Model.DeliveredOrders</div>
                <div class="dashboard-stat-label">Đã giao hàng</div>
            </div>
        </div>
    </div>

    <!-- Đơn hàng bị hủy -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="dashboard-stat" style="border-left: 4px solid #dc3545;">
                <div class="dashboard-stat-icon" style="background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);">
                    <i class="fas fa-times-circle"></i>
                </div>
                <div class="dashboard-stat-value" style="color: #dc3545;">@Model.CancelledOrders</div>
                <div class="dashboard-stat-label">Đơn đã hủy</div>
            </div>
        </div>
    </div>

    <!-- Biểu đồ doanh thu -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="dashboard-card">
                <div class="card-header">
                    <i class="fas fa-chart-area"></i>
                    <span>Biểu đồ doanh thu theo thời gian</span>
                </div>
                <div class="card-body">
                    <canvas id="revenueChart" height="100"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Sản phẩm bán chạy -->
    <div class="row mb-4">
        <div class="col-lg-6">
            <div class="dashboard-card">
                <div class="card-header">
                    <i class="fas fa-fire"></i>
                    <span>Top 5 sản phẩm bán chạy</span>
                </div>
                <div class="card-body">
                    @if (Model.TopProducts != null && Model.TopProducts.Any())
                    {
                        <table class="table dashboard-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Sản phẩm</th>
                                    <th class="text-end">Số lượng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{int rank = 1;}
                                @foreach (var product in Model.TopProducts)
                                {
                                    <tr>
                                        <td><span class="badge bg-warning text-dark">@rank</span></td>
                                        <td>@product.ProductName</td>
                                        <td class="text-end fw-bold">@product.Quantity</td>
                                    </tr>
                                    rank++;
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted text-center py-4">Chưa có dữ liệu</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="dashboard-card">
                <div class="card-header">
                    <i class="fas fa-chart-pie"></i>
                    <span>Phân bố đơn hàng theo trạng thái</span>
                </div>
                <div class="card-body">
                    <canvas id="orderStatusChart" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Revenue Chart
        var revenueCtx = document.getElementById('revenueChart').getContext('2d');
        var revenueData = @Html.Raw(Json.Serialize(Model.DailyStatistics ?? new List<NgoHuuDuc_2280600725.Models.ViewModels.DailyStatisticsViewModel>()));

        new Chart(revenueCtx, {
            type: 'line',
            data: {
                labels: revenueData.map(item => new Date(item.Date).toLocaleDateString('vi-VN')),
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: revenueData.map(item => item.Revenue),
                    borderColor: '#D4AF37',
                    backgroundColor: 'rgba(212, 175, 55, 0.1)',
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return value.toLocaleString('vi-VN') + '₫';
                            }
                        }
                    }
                }
            }
        });

        // Order Status Chart
        var statusCtx = document.getElementById('orderStatusChart').getContext('2d');
        new Chart(statusCtx, {
            type: 'doughnut',
            data: {
                labels: ['Chờ xử lý', 'Đã xác nhận', 'Đang giao', 'Đã giao', 'Đã hủy'],
                datasets: [{
                    data: [@Model.PendingOrders, @Model.ConfirmedOrders, @Model.ShippingOrders, @Model.DeliveredOrders, @Model.CancelledOrders],
                    backgroundColor: ['#ffc107', '#17a2b8', '#6f42c1', '#28a745', '#dc3545'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });
    </script>
}
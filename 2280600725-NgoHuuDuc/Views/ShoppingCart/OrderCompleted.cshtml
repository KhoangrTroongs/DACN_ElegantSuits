@model int

<div class="container mt-5">
    <div class="text-center">
        <div class="mb-4">
            <i class="bx bx-check-circle text-success" style="font-size: 5rem;"></i>
        </div>
        <h2 class="mb-3">Đặt Hàng Thành Công!</h2>
        <p class="lead mb-4">Cảm ơn bạn đã mua hàng. Đơn hàng #@Model đã được đặt thành công.</p>
        <p>Chúng tôi đã gửi email xác nhận với chi tiết đơn hàng của bạn.</p>
        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary me-2">Tiếp Tục Mua Sắm</a>
            <a asp-controller="ShoppingCart" asp-action="MyOrders" class="btn btn-outline-secondary">Xem Đơn Hàng Của Tôi</a>
        </div>
    </div>
</div>

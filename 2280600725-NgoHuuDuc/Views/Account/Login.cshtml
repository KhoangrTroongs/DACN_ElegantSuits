@model NgoHuuDuc_2280600725.Models.AccountViewModels.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Elegant Suits</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/elegant-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modern-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
        }
        .google-btn {
            background-color: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            color: #fff;
            padding: 12px 24px;
            font-size: 14px;
            font-weight: 500;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            transition: all 0.3s;
            width: 100%;
        }
        .google-btn:hover {
            background-color: rgba(255,255,255,0.15);
            border-color: rgba(255,255,255,0.3);
            color: #fff;
            transform: translateY(-2px);
        }
        .google-icon {
            width: 20px;
            height: 20px;
        }
        .divider {
            display: flex;
            align-items: center;
            text-align: center;
            margin: 24px 0;
        }
        .divider::before,
        .divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid rgba(255,255,255,0.2);
        }
        .divider span {
            padding: 0 16px;
            color: rgba(255,255,255,0.5);
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .form-label-dark {
            color: rgba(255,255,255,0.8);
            font-weight: 500;
            margin-bottom: 8px;
        }
        .form-check-dark .form-check-input {
            background-color: rgba(255,255,255,0.1);
            border-color: rgba(255,255,255,0.3);
        }
        .form-check-dark .form-check-input:checked {
            background-color: var(--elegant-gold);
            border-color: var(--elegant-gold);
        }
        .form-check-dark .form-check-label {
            color: rgba(255,255,255,0.7);
        }
        .link-gold {
            color: var(--elegant-gold);
            text-decoration: none;
            transition: all 0.3s;
        }
        .link-gold:hover {
            color: var(--elegant-gold-light);
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-card animate-scaleIn">
            <!-- Logo -->
            <div class="login-logo">
                <i class="fas fa-tshirt"></i>
            </div>

            <!-- Title -->
            <h1 class="login-title">Elegant Suits</h1>
            <p class="login-subtitle">Đăng nhập vào tài khoản của bạn</p>

            <!-- Login Form -->
            <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                <div asp-validation-summary="All" class="alert alert-danger" style="background: rgba(244,67,54,0.1); border: 1px solid rgba(244,67,54,0.3); color: #F44336; border-radius: 12px; display: none;"></div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label-dark">
                        <i class="fas fa-envelope me-2"></i>Email
                    </label>
                    <input asp-for="Email" class="form-control form-control-dark" placeholder="Nhập email của bạn" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label-dark">
                        <i class="fas fa-lock me-2"></i>Mật khẩu
                    </label>
                    <input asp-for="Password" class="form-control form-control-dark" placeholder="Nhập mật khẩu" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4 form-check-dark">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">Ghi nhớ đăng nhập</label>
                    </div>
                </div>

                <button type="submit" class="btn btn-gold-gradient w-100 mb-3">
                    <i class="fas fa-sign-in-alt me-2"></i>Đăng nhập
                </button>
            </form>

            <div class="divider">
                <span>Hoặc</span>
            </div>

            <!-- Google Login -->
            <form asp-controller="Account" asp-action="ExternalLogin" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                <input type="hidden" name="provider" value="Google" />
                <button type="submit" class="google-btn">
                    <svg class="google-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                    </svg>
                    Đăng nhập với Google
                </button>
            </form>

            <!-- Register Link -->
            <div class="text-center mt-4">
                <p style="color: rgba(255,255,255,0.6);">
                    Chưa có tài khoản?
                    <a asp-action="Register" asp-route-returnurl="@ViewData["ReturnUrl"]" class="link-gold">Đăng ký ngay</a>
                </p>
            </div>

            <!-- Back to Home -->
            <div class="text-center mt-3">
                <a asp-controller="Home" asp-action="Index" class="link-gold" style="font-size: 14px;">
                    <i class="fas fa-arrow-left me-1"></i> Quay về trang chủ
                </a>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        // Show validation summary if there are errors
        $(document).ready(function() {
            var validationSummary = $('[asp-validation-summary]');
            if (validationSummary.find('li').length > 0 || validationSummary.text().trim().length > 0) {
                validationSummary.show();
            }
        });
    </script>
</body>
</html>

@model UpdateCouponDTO
@using NgoHuuDuc_2280600725.DTOs

@{
    ViewData["Title"] = "Cập Nhật Mã Giảm Giá";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h2 class="mb-4">Cập Nhật Mã Giảm Giá</h2>

            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="card">
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Mã Giảm Giá</label>
                            <input type="text" class="form-control" value="@ViewData["CouponCode"]" disabled />
                            <small class="text-muted">Không thể thay đổi mã giảm giá</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Chú Thích</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="VD: Giảm giá cho đơn hàng từ 500.000đ"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                            <small class="text-muted">Mô tả điều kiện hoặc thông tin về coupon (tối đa 500 ký tự)</small>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="DiscountPercentage" class="form-label">Phần Trăm Giảm (%)</label>
                                    <select asp-for="DiscountPercentage" class="form-select">
                                        <option value="">-- Chọn phần trăm giảm --</option>
                                        @for (int i = 1; i <= 100; i++)
                                        {
                                            <option value="@i">@i%</option>
                                        }
                                    </select>
                                    <span asp-validation-for="DiscountPercentage" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Quantity" class="form-label">Số Lượng</label>
                                    <input asp-for="Quantity" type="number" class="form-control" />
                                    <span asp-validation-for="Quantity" class="text-danger"></span>
                                    <small class="text-muted">-1 = Không giới hạn, 0 = Hết hạn</small>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MinimumAmount" class="form-label">Giá Tối Thiểu (₫)</label>
                            <input asp-for="MinimumAmount" type="number" min="0" step="1000" class="form-control" placeholder="VD: 500000" />
                            <span asp-validation-for="MinimumAmount" class="text-danger"></span>
                            <small class="text-muted">
                                <i class="fas fa-info-circle"></i> Giá trị đơn hàng tối thiểu để áp dụng mã giảm giá này. Nhập 0 nếu không có điều kiện.
                            </small>
                        </div>

                        <div class="mb-3" id="expiryDateContainer">
                            <label asp-for="ExpiryDate" class="form-label">Ngày Hết Hạn</label>
                            <input asp-for="ExpiryDate" type="datetime-local" class="form-control" />
                            <span asp-validation-for="ExpiryDate" class="text-danger"></span>
                            <small class="text-muted">
                                <i class="fas fa-calendar-alt"></i> Bắt buộc khi số lượng không phải là "Không giới hạn"
                            </small>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input asp-for="IsActive" type="checkbox" class="form-check-input" id="IsActive" />
                                <label class="form-check-label" for="IsActive">
                                    Kích hoạt mã giảm giá
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Cập Nhật
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            // Handle ExpiryDate visibility based on Quantity
            const quantityInput = $('#Quantity');
            const expiryDateContainer = $('#expiryDateContainer');
            const expiryDateInput = $('#ExpiryDate');

            function toggleExpiryDate() {
                const quantity = parseInt(quantityInput.val());
                if (quantity === -1) {
                    // Hide ExpiryDate when quantity is unlimited
                    expiryDateContainer.hide();
                    expiryDateInput.removeAttr('required');
                } else {
                    // Show ExpiryDate when quantity is limited
                    expiryDateContainer.show();
                    expiryDateInput.attr('required', 'required');
                }
            }

            // Initial check
            toggleExpiryDate();

            // Listen for changes
            quantityInput.on('change', toggleExpiryDate);
            quantityInput.on('input', toggleExpiryDate);
        });
    </script>
}


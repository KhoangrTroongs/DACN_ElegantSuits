@model IEnumerable<CouponDTO>
@using NgoHuuDuc_2280600725.DTOs

@{
    ViewData["Title"] = "Quản Lý Mã Giảm Giá";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>Quản Lý Mã Giảm Giá</h2>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Tạo Mã Giảm Giá
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Mã Giảm Giá</th>
                        <th>Phần Trăm Giảm</th>
                        <th>Số Lượng</th>
                        <th>Ngày Hết Hạn</th>
                        <th>Trạng Thái</th>
                        <th>Kích Hoạt</th>
                        <th>Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var coupon in Model)
                    {
                        <tr>
                            <td>
                                <strong>@coupon.Code</strong>
                            </td>
                            <td>
                                <span class="badge bg-info">@coupon.DiscountPercentage%</span>
                            </td>
                            <td>
                                @if (coupon.Quantity == -1)
                                {
                                    <span class="badge bg-success">Không giới hạn</span>
                                }
                                else if (coupon.Quantity == 0)
                                {
                                    <span class="badge bg-danger">Hết</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">@coupon.Quantity</span>
                                }
                            </td>
                            <td>
                                @coupon.ExpiryDate.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>
                                @if (coupon.IsExpired)
                                {
                                    <span class="badge bg-danger">Đã hết hạn</span>
                                }
                                else if (coupon.IsDepleted)
                                {
                                    <span class="badge bg-danger">Đã hết số lượng</span>
                                }
                                else if (!coupon.IsActive)
                                {
                                    <span class="badge bg-secondary">Không kích hoạt</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Còn hiệu lực</span>
                                }
                            </td>
                            <td>
                                @if (coupon.IsActive)
                                {
                                    <i class="fas fa-check text-success"></i>
                                }
                                else
                                {
                                    <i class="fas fa-times text-danger"></i>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@coupon.Id" class="btn btn-sm btn-warning">
                                    <i class="fas fa-edit"></i> Sửa
                                </a>
                                <a asp-action="Delete" asp-route-id="@coupon.Id" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash"></i> Xóa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> Không có mã giảm giá nào. <a asp-action="Create">Tạo mã giảm giá mới</a>
        </div>
    }
</div>


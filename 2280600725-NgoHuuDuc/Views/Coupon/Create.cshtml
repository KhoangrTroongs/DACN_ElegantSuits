@model CreateCouponDTO
@using NgoHuuDuc_2280600725.DTOs

@{
    ViewData["Title"] = "Tạo Mã Giảm Giá";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h2 class="mb-4">Tạo Mã Giảm Giá Mới</h2>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="card">
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Code" class="form-label">Mã Giảm Giá</label>
                            <div class="input-group">
                                <input asp-for="Code" class="form-control" id="codeInput" placeholder="Để trống để tạo mã tự động (VD: COUPON-ABC12345)" />
                                <button type="button" class="btn btn-outline-secondary" id="generateCodeBtn" title="Tạo mã tự động">
                                    <i class="fas fa-magic"></i> Tạo mã
                                </button>
                            </div>
                            <span asp-validation-for="Code" class="text-danger"></span>
                            <small class="text-muted">
                                <i class="fas fa-info-circle"></i> Để trống để hệ thống tạo mã tự động, hoặc nhập mã thủ công. Mã sẽ được chuyển thành chữ hoa.
                            </small>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="DiscountPercentage" class="form-label">Phần Trăm Giảm (%)</label>
                                    <input asp-for="DiscountPercentage" type="number" step="0.01" min="0" max="100" class="form-control" placeholder="VD: 10" />
                                    <span asp-validation-for="DiscountPercentage" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Quantity" class="form-label">Số Lượng</label>
                                    <input asp-for="Quantity" type="number" class="form-control" placeholder="VD: 100" />
                                    <span asp-validation-for="Quantity" class="text-danger"></span>
                                    <small class="text-muted">-1 = Không giới hạn, 0 = Hết hạn</small>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3" id="expiryDateContainer">
                            <label asp-for="ExpiryDate" class="form-label">Ngày Hết Hạn</label>
                            <input asp-for="ExpiryDate" type="datetime-local" class="form-control" />
                            <span asp-validation-for="ExpiryDate" class="text-danger"></span>
                            <small class="text-muted">
                                <i class="fas fa-calendar-alt"></i> Bắt buộc khi số lượng không phải là "Không giới hạn"
                            </small>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input asp-for="IsActive" type="checkbox" class="form-check-input" id="IsActive" checked />
                                <label class="form-check-label" for="IsActive">
                                    Kích hoạt mã giảm giá
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Tạo Mã Giảm Giá
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            // Handle ExpiryDate visibility based on Quantity
            const quantityInput = $('#Quantity');
            const expiryDateContainer = $('#expiryDateContainer');
            const expiryDateInput = $('#ExpiryDate');

            function toggleExpiryDate() {
                const quantity = parseInt(quantityInput.val());
                if (quantity === -1) {
                    // Hide ExpiryDate when quantity is unlimited
                    expiryDateContainer.hide();
                    expiryDateInput.removeAttr('required');
                } else {
                    // Show ExpiryDate when quantity is limited
                    expiryDateContainer.show();
                    expiryDateInput.attr('required', 'required');
                }
            }

            // Initial check
            toggleExpiryDate();

            // Listen for changes
            quantityInput.on('change', toggleExpiryDate);
            quantityInput.on('input', toggleExpiryDate);

            // Handle Generate Code button
            $('#generateCodeBtn').on('click', function () {
                const btn = $(this);
                const originalText = btn.html();
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang tạo...');

                $.ajax({
                    url: '@Url.Action("GenerateCode", "Coupon")',
                    type: 'GET',
                    dataType: 'json',
                    success: function (response) {
                        if (response.success) {
                            $('#codeInput').val(response.code);
                            // Show success message
                            const alert = $('<div class="alert alert-success alert-dismissible fade show" role="alert">' +
                                '<i class="fas fa-check-circle"></i> Mã tự động: <strong>' + response.code + '</strong>' +
                                '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                                '</div>');
                            $('#codeInput').closest('.mb-3').before(alert);
                            setTimeout(() => alert.fadeOut(() => alert.remove()), 3000);
                        } else {
                            alert('Lỗi: ' + response.message);
                        }
                    },
                    error: function () {
                        alert('Lỗi khi tạo mã giảm giá');
                    },
                    complete: function () {
                        btn.prop('disabled', false).html(originalText);
                    }
                });
            });
        });
    </script>
}


@model NgoHuuDuc_2280600725.DTOs.FabricGroupDTO

@{
    ViewData["Title"] = $"Nhóm Vải: {Model?.Name}";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-12">
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm mb-3">
                <i class="fas fa-arrow-left me-1"></i>Quay Lại
            </a>
            <h1 class="display-5">
                <i class="fas fa-layer-group me-2"></i>@Model?.Name
            </h1>
            <p class="lead text-muted">@Model?.Description</p>
        </div>
    </div>

    @if (Model?.Fabrics != null && Model.Fabrics.Any())
    {
        <div class="row">
            @foreach (var fabric in Model.Fabrics.OrderBy(f => f.Name))
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm hover-shadow">
                        @if (!string.IsNullOrEmpty(fabric.ImageUrl))
                        {
                            <img src="@fabric.ImageUrl" class="card-img-top" alt="@fabric.Name" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                <i class="fas fa-image text-muted" style="font-size: 3rem;"></i>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">@fabric.Name</h5>
                            <p class="card-text text-muted small">@fabric.Description</p>
                            <p class="text-secondary small mb-2">
                                <strong>Thành Phần:</strong> @fabric.Composition
                            </p>
                            <p class="text-primary">
                                <strong>Giá:</strong> @fabric.Price.ToString("N0") đ
                            </p>
                        </div>
                        <div class="card-footer bg-white border-top">
                            <a href="@Url.Action("FabricDetail", new { fabricId = fabric.Id })" 
                               class="btn btn-primary btn-sm w-100">
                                <i class="fas fa-eye me-1"></i>Xem Chi Tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <i class="fas fa-info-circle me-2"></i>Nhóm vải này chưa có loại vải nào.
        </div>
    }
</div>

<style>
    .hover-shadow {
        transition: box-shadow 0.3s ease-in-out;
    }

    .hover-shadow:hover {
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }

    .card {
        border: none;
        border-radius: 0.5rem;
    }

    .card-title {
        color: #2c3e50;
        font-weight: 600;
    }
</style>


@using NgoHuuDuc_2280600725.DTOs
@using NgoHuuDuc_2280600725.Models.ViewModels
@model DesignProductViewModel
@{
    ViewData["Title"] = "Thiết Kế Sản Phẩm";
    var product = Model.Product;
    var fabricGroups = Model.FabricGroups;
}

<div class="container-fluid mt-5">
    <div class="row mb-4">
        <div class="col-md-12">
            <a href="@Url.Action("SelectProduct")" class="btn btn-outline-secondary btn-sm mb-3">
                <i class="fas fa-arrow-left me-1"></i>Quay Lại
            </a>
            <h1 class="display-5">
                <i class="fas fa-palette me-2"></i>Thiết Kế: @product?.Name
            </h1>
        </div>
    </div>

    <div class="row">
        <!-- Product Preview -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm sticky-top" style="top: 20px;">
                <div class="card-body">
                    <h5 class="card-title">Xem Trước Sản Phẩm</h5>
                    @if (!string.IsNullOrEmpty(product?.ImageUrl))
                    {
                        <img src="@product.ImageUrl" class="img-fluid rounded mb-3" alt="@product?.Name">
                    }
                    else
                    {
                        <div class="bg-light rounded d-flex align-items-center justify-content-center mb-3" style="height: 300px;">
                            <i class="fas fa-image text-muted" style="font-size: 3rem;"></i>
                        </div>
                    }
                    <table class="table table-sm">
                        <tr>
                            <td><strong>Tên:</strong></td>
                            <td>@product?.Name</td>
                        </tr>
                        <tr>
                            <td><strong>Giá:</strong></td>
                            <td class="text-primary">@product?.Price.ToString("N0") đ</td>
                        </tr>
                        <tr>
                            <td><strong>Số Lượng:</strong></td>
                            <td>@product?.Quantity</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <!-- Fabric Selection -->
        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="fas fa-layer-group me-2"></i>Chọn Vải
                    </h5>
                    <p class="text-muted">Chọn vải yêu thích của bạn từ các nhóm dưới đây</p>

                    @if (fabricGroups != null && fabricGroups.Any())
                    {
                        <div class="accordion" id="fabricAccordion">
                            @{
                                int groupIndex = 0;
                                var sortedGroups = fabricGroups.ToList();
                                sortedGroups = sortedGroups.OrderBy(g => g.DisplayOrder).ToList();
                            }
                            @foreach (var group in sortedGroups)
                            {
                                var fabricList = group.Fabrics?.ToList() ?? new List<FabricDTO>();
                                fabricList = fabricList.OrderBy(f => f.Name).ToList();

                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="heading@groupIndex">
                                        <button class="accordion-button @(groupIndex > 0 ? "collapsed" : "")" type="button" data-bs-toggle="collapse" data-bs-target="#collapse@groupIndex" aria-expanded="@(groupIndex == 0 ? "true" : "false")" aria-controls="collapse@groupIndex">
                                            <i class="fas fa-layer-group me-2"></i>@group.Name
                                            <span class="badge bg-primary ms-2">@(group.Fabrics?.Count() ?? 0)</span>
                                        </button>
                                    </h2>
                                    <div id="collapse@groupIndex" class="accordion-collapse collapse @(groupIndex == 0 ? "show" : "")" aria-labelledby="heading@groupIndex" data-bs-parent="#fabricAccordion">
                                        <div class="accordion-body">
                                            <div class="row">
                                                @if (fabricList.Any())
                                                {
                                                    @foreach (var fabric in fabricList)
                                                    {
                                                        <div class="col-md-6 mb-3">
                                                            <div class="card fabric-card cursor-pointer" data-fabric-id="@fabric.Id" data-fabric-name="@fabric.Name" data-fabric-price="@fabric.Price">
                                                                <div class="card-body">
                                                                    <h6 class="card-title">@fabric.Name</h6>
                                                                    <p class="card-text small text-muted">@fabric.Composition</p>
                                                                    <p class="card-text">
                                                                        <strong class="text-primary">@fabric.Price.ToString("N0") đ</strong>
                                                                    </p>
                                                                    <div class="form-check">
                                                                        <input class="form-check-input fabric-checkbox" type="checkbox" id="fabric@(fabric.Id)" value="@fabric.Id">
                                                                        <label class="form-check-label" for="fabric@(fabric.Id)">
                                                                            Chọn
                                                                        </label>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="col-12">
                                                        <p class="text-muted">Nhóm vải này chưa có loại vải nào.</p>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                groupIndex++;
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>Chưa có nhóm vải nào.
                        </div>
                    }
                </div>
            </div>

            <!-- Selected Fabrics Summary -->
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="fas fa-check-circle me-2"></i>Vải Đã Chọn
                    </h5>
                    <div id="selectedFabricsList">
                        <p class="text-muted">Chưa chọn vải nào</p>
                    </div>
                    <div class="mt-3">
                        <button class="btn btn-primary btn-lg w-100" id="addToCartBtn" disabled>
                            <i class="fas fa-shopping-cart me-2"></i>Thêm Vào Giỏ Hàng
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .fabric-card {
        border: 2px solid #e9ecef;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .fabric-card:hover {
        border-color: #007bff;
        box-shadow: 0 0.5rem 1rem rgba(0, 123, 255, 0.15);
    }

    .fabric-card.selected {
        border-color: #007bff;
        background-color: #f0f7ff;
    }

    .accordion-button:not(.collapsed) {
        background-color: #f8f9fa;
        color: #007bff;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const fabricCheckboxes = document.querySelectorAll('.fabric-checkbox');
        const selectedFabricsList = document.getElementById('selectedFabricsList');
        const addToCartBtn = document.getElementById('addToCartBtn');

        fabricCheckboxes.forEach(checkbox => {
            checkbox.addEventListener('change', function() {
                updateSelectedFabrics();
            });
        });

        function updateSelectedFabrics() {
            const selected = Array.from(fabricCheckboxes)
                .filter(cb => cb.checked)
                .map(cb => {
                    const card = cb.closest('.fabric-card');
                    return {
                        id: cb.value,
                        name: card.dataset.fabricName,
                        price: parseFloat(card.dataset.fabricPrice)
                    };
                });

            if (selected.length === 0) {
                selectedFabricsList.innerHTML = '<p class="text-muted">Chưa chọn vải nào</p>';
                addToCartBtn.disabled = true;
            } else {
                let html = '<ul class="list-group">';
                let totalPrice = 0;
                selected.forEach(fabric => {
                    html += `<li class="list-group-item d-flex justify-content-between align-items-center">
                        ${fabric.name}
                        <span class="badge bg-primary rounded-pill">${fabric.price.toLocaleString('vi-VN')} đ</span>
                    </li>`;
                    totalPrice += fabric.price;
                });
                html += '</ul>';
                html += `<div class="mt-3"><strong>Tổng Giá Vải:</strong> <span class="text-primary">${totalPrice.toLocaleString('vi-VN')} đ</span></div>`;
                selectedFabricsList.innerHTML = html;
                addToCartBtn.disabled = false;
            }
        }

        addToCartBtn.addEventListener('click', function() {
            const selected = Array.from(fabricCheckboxes)
                .filter(cb => cb.checked)
                .map(cb => cb.value);

            if (selected.length > 0) {
                // TODO: Add to cart with selected fabrics
                alert('Chức năng thêm vào giỏ hàng sẽ được cập nhật sớm!');
            }
        });
    });
</script>


@model Order

@{
    ViewData["Title"] = "Thanh Toán Thất Bại";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body text-center">
                    <div class="mb-4">
                        <i class="fas fa-times-circle text-danger" style="font-size: 5rem;"></i>
                    </div>
                    <h2 class="text-danger mb-3">Thanh Toán Thất Bại!</h2>
                    
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["ErrorMessage"]
                        </div>
                    }
                    else
                    {
                        <p class="lead">Đã có lỗi xảy ra trong quá trình thanh toán. Vui lòng thử lại.</p>
                    }

                    @if (Model != null)
                    {
                        <div class="alert alert-warning mt-4">
                            <h5><i class="fas fa-info-circle"></i> Thông Tin Đơn Hàng</h5>
                            <hr>
                            <div class="row text-start">
                                <div class="col-md-6">
                                    <p><strong>Mã đơn hàng:</strong> #@Model.Id</p>
                                    <p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                                </div>
                                <div class="col-md-6">
                                    <p><strong>Tổng tiền:</strong> @Model.TotalAmount.ToString("N0")đ</p>
                                    <p><strong>Trạng thái:</strong> <span class="badge bg-danger">Thanh toán thất bại</span></p>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4">
                            <p class="text-muted">Đơn hàng của bạn vẫn được lưu. Bạn có thể thử thanh toán lại hoặc chọn phương thức thanh toán khác.</p>
                        </div>
                    }

                    <div class="mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary me-2">
                            <i class="fas fa-home"></i> Về Trang Chủ
                        </a>
                        @if (Model != null)
                        {
                            <a asp-controller="ShoppingCart" asp-action="MyOrders" class="btn btn-outline-primary">
                                <i class="fas fa-list"></i> Xem Đơn Hàng
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@model NgoHuuDuc_2280600725.DTOs.UpdateFabricGroupDTO
@{
    ViewData["Title"] = "Chỉnh sửa nhóm vải";
    var fabricGroupId = ViewBag.FabricGroupId;
}

<div class="dashboard-card">
    <div class="card-header">
        <span><i class="fas fa-layer-group me-2"></i>Chỉnh sửa nhóm vải</span>
    </div>
    <div class="card-body">
        <form asp-action="EditFabricGroup" asp-route-id="@fabricGroupId" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Tên nhóm vải <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Mô tả</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DisplayOrder" class="form-label">Thứ tự hiển thị</label>
                <input asp-for="DisplayOrder" type="number" class="form-control" />
                <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                <small class="form-text text-muted">Nhóm vải sẽ được sắp xếp theo thứ tự này (từ nhỏ đến lớn)</small>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-elegant-primary">
                    <i class="fas fa-save me-2"></i>Cập nhật
                </button>
                <a asp-action="FabricGroups" class="btn btn-secondary">
                    <i class="fas fa-times me-2"></i>Hủy
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

